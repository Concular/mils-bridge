# MILS Bridge — copy to .env and edit. `docker compose up -d` reads it.
#
# Everything here is optional except MILS_ACTOR_CODE_SELF, and every upstream
# value is a SEED: whatever you save on the console's Settings pages is stored
# in the database and wins at request time. docs/configuration.md is the full
# table, including the variables the image already sets for you (PORT,
# DATABASE_URL, FILE_STORE_DIR, SERVE_WEB_DIST, NODE_ENV).

# --- The deployment ---------------------------------------------------------

# Which release to run. `latest` is the newest tagged release; pin the version
# you tested (e.g. 0.1.0) on anything you care about. docker compose pull &&
# docker compose up -d applies a change here.
BRIDGE_VERSION=0.1.0

# The origin the browser uses. Also the CORS allow-list, so it must be the
# public URL and not the container port. Behind the tls profile below, set it
# to https://<your domain>.
WEB_ORIGIN=http://localhost:8080

# Where the container's port 8080 is published. Loopback by default. Under the
# tls profile, delete the `ports:` block in compose.yaml instead of widening
# this — an open 8080 beside Caddy is a plaintext way past it.
BRIDGE_BIND=127.0.0.1
BRIDGE_PORT=8080

# The `tls` profile only: the host name Caddy gets a certificate for.
# Its DNS must already point here, and 80 + 443 must be reachable.
# BRIDGE_DOMAIN=bridge.example.com

# Required behind any reverse proxy, including the tls profile. Rate limiting
# keys on the request IP, so without this every request shares the proxy's
# address and the per-client limit becomes a global one. `1` = trust one hop.
# Set it ONLY for a front end you control.
# TRUST_PROXY=1

# --- This node's identity on the MILS network -------------------------------

# YOUR OWN MILS ActorCode. It decides the audience this node stamps on every
# outbound token and the `sub` beside it, so it is the deployment's network
# identity, not a label. Leaving it unset falls back to `conc` — Concular's
# own actor — and the bridge logs a boot warning, because nothing else fails
# when a node introduces itself as somebody else.
MILS_ACTOR_CODE_SELF=

# The MILS instance this node registers into, origin + /rest.
MILS_BASE_URL=https://mils.example.org/rest

# A ready-made bearer token for MILS, if you have one. Leave empty and
# configure an RS256 signing key on the Settings page instead: a minted token
# outranks this, and is what a MILS node normally authenticates with.
MILS_JWT=

# Accepted `aud` on every inbound peer token, comma-separated. LEAVE IT
# COMMENTED OUT: unset means the node accepts tokens addressed to its own
# names, derived from MILS_ACTOR_CODE_SELF. Setting it PINS the list and 401s
# every peer that addresses you by any other name; an assignment with no value
# skips the check entirely.
# MILS_TOKEN_AUDIENCE=

# --- Who may read what ------------------------------------------------------

# How far the bridge acts on an access decision: off | shadow | enforce.
# `shadow` records what WOULD be blocked without refusing anything — watch the
# denial numbers on Access → Statistics, then switch to `enforce`.
ACCESS_ENFORCEMENT=shadow

# Who may read /rest/* — the endpoints a peer node calls for a registered
# item's payload and bytes: open | actor | node.
# `open` is the published contract: no credential, so anyone who can reach this
# node can read any registered item. Note that with `open`,
# ACCESS_ENFORCEMENT=enforce does not protect item data — a blocked node reads
# the same bytes here. Set `actor` or `node` if that matters to you.
MILS_INTERNAL_AUTH=open

# Reading a PEER-owned item from the node that owns it. Off means the routes do
# not exist (a 404, not a 403). Only the literal `on` enables it, and it should
# be switched on by someone who meant to: every other outbound call this bridge
# makes goes somewhere you configured, this one goes wherever MILS says a peer
# lives.
# PEER_FEDERATION=on

# --- Secrets at rest --------------------------------------------------------

# 32 bytes, base64 or hex: `openssl rand -base64 32`. With this set, the stored
# credentials (MILS signing key and passphrase, Concore API key, Google client
# secret and per-user OAuth tokens, API Explorer credentials) are AES-256-GCM
# encrypted in SQLite. Strongly recommended on a shared host. Set it BEFORE
# first use, or run `encrypt:secrets` afterwards (docs/runbooks.md). Keep a
# copy: the bridge refuses to start if it finds encrypted rows and this is
# unset.
SECRETS_KEY=

# --- Sources (all optional; each one shows as unconfigured until you set it) -

# Concore. Either a bearer token or an API key + organisation id.
# CONCORE_BASE_URL=https://concore.example.com/api/v2
CONCORE_TOKEN=
CONCORE_API_KEY=
CONCORE_ORG_ID=

# Google Drive: one OAuth app for the deployment, then each console user
# connects their own Google account. The redirect URI is derived from
# WEB_ORIGIN by compose.yaml; register that exact URL on the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Limits (defaults shown; raise or lower as needed) ----------------------

# FILE_STORE_MAX_BYTES=209715200
# API_EXPLORER_MAX_REQUEST_BYTES=10485760
# API_EXPLORER_RETENTION_PER_API=500
# THROTTLE_LIMIT=300
# LOG_LEVEL=log
